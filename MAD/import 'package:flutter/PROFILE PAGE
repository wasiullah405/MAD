import 'package:flutter/material.dart';
import 'constants.dart';
import 'widgets.dart';

class ProfilePage extends StatelessWidget {
  const ProfilePage({super.key});

  Widget info(IconData icon, String label, String value) => Padding(
        padding: const EdgeInsets.symmetric(vertical: 8),
        child: Row(
          children: [
            Icon(icon, color: accent, size: 22),
            const SizedBox(width: 12),
            Expanded(
              child: Text.rich(TextSpan(
                style: const TextStyle(fontSize: 16, color: Colors.black87),
                children: [
                  TextSpan(
                      text: '$label: ',
                      style: const TextStyle(fontWeight: FontWeight.bold)),
                  TextSpan(text: value),
                ],
              )),
            ),
          ],
        ),
      );

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(myName.toUpperCase()),
        centerTitle: true,
        backgroundColor: primary,
        foregroundColor: Colors.white,
      ),
      body: SingleChildScrollView(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Container(
              color: primary,
              padding: const EdgeInsets.symmetric(vertical: 25),
              child: Column(
                children: [
                  photo(120),
                  const SizedBox(height: 15),
                  const Text(myName,
                      style: TextStyle(
                          fontSize: 24,
                          fontWeight: FontWeight.bold,
                          color: Colors.white)),
                  const SizedBox(height: 5),
                  const Text(myTitle,
                      style: TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.w600,
                          color: Color(0xFF7FDBCF))),
                ],
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  heading('Personal Information'),
                  info(Icons.email, 'Email', myEmail),
                  info(Icons.school, 'University', myUniversity),
                  info(Icons.book, 'Program', myProgram),
                  info(Icons.calendar_today, 'Semester', mySemester),
                  info(Icons.location_on, 'City', myCity),
                  info(Icons.cake, 'Age', myAge),
                  const Divider(height: 40),
                  heading('About Me'),
                  const Text(aboutMe, style: TextStyle(fontSize: 16, height: 1.5)),
                  const SizedBox(height: 25),
                  button('Contact Us', () {
                    showDialog(
                      context: context,
                      builder: (_) => AlertDialog(
                        title: const Text('Contact Us'),
                        content: const Text(myPhone,
                            style: TextStyle(
                                fontSize: 22, fontWeight: FontWeight.bold)),
                        actions: [
                          TextButton(
                              onPressed: () => Navigator.pop(context),
                              child: const Text('Close')),
                        ],
                      ),
                    );
                  }),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
